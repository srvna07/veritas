{
  "name": "@veritas/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../apps/web/.env.local src/migrate.ts"
  },
  "dependencies": {
    "@veritas/schemas": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "postgres": "^4.1.1"
  },
  "devDependencies": {
    "@veritas/config": "workspace:*",
    "@types/node": "catalog:",
    "drizzle-kit": "^0.31.11",
    "eslint": "catalog:",
    "tsx": "^4.23.15",
    "typescript": "catalog:"
  }
}
