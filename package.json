{
  "name": "veritas",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@veritas/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @veritas/db generate",
    "db:migrate": "pnpm --filter @veritas/db migrate",
    "db:seed-admin": "pnpm --filter @veritas/auth seed-admin"
  },
  "devDependencies": {
    "turbo": "^2.11.13",
    "typescript": "~5.9.3"
  }
}
