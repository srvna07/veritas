{
  "name": "veritas",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @veritas/db db:generate",
    "db:migrate": "pnpm --filter @veritas/db db:migrate",
    "seed:admin": "pnpm --filter @veritas/web seed:admin"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "eslint": "catalog:",
    "prettier": "^3.10.1",
    "turbo": "^2.11.13",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
