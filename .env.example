# Copy to frontend/.env.local and fill in. Never commit real values.

# --- Database (matches docker-compose.yml) ---
DATABASE_URL=postgres://veritas:veritas@localhost:5432/veritas

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Set to true when running behind a reverse proxy in production
# AUTH_TRUST_HOST=true

# Public base URL, used to build password-reset links
APP_URL=http://localhost:3000

# --- Gmail SMTP (password reset emails) ---
# Use a Google "App Password" (Google Account > Security > 2-Step Verification > App passwords),
# NOT your normal Gmail password. If SMTP_USER/SMTP_PASS are empty, reset links are printed to
# the server console in development instead of being emailed.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Veritas <your.address@gmail.com>"

# --- First admin (used only by `pnpm seed:admin`) ---
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=Admin
SEED_ADMIN_PASSWORD=
